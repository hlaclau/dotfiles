theme = Catppuccin Mocha
background-opacity = 0.9
font-size = 14
mouse-hide-while-typing = true
keybind = shift+enter=text:\n

# Colors of the current theme (scripts/theme.sh), overriding the theme above
config-file = ?~/.config/theme/ghostty

# Platform-specific settings (font, decorations, keybinds, ...) from the mac/ or arch/ package
config-file = ?platform
