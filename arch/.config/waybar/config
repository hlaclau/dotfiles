// Flat top bar with an empty center: the quickshell island hangs there.
// Height matches the island (Theme.barHeight in ~/.config/quickshell/Theme.qml).
{
  "layer": "top",
  "position": "top",
  "height": 36,
  "spacing": 0,
  "exclusive": true,

  "modules-left": [
    "hyprland/workspaces",
    "group/system"
  ],
  "modules-center": [],
  "modules-right": [
    "hyprland/language",
    "group/audio",
    "tray"
  ],

  "hyprland/workspaces": {
    "format": "{id}",
    "on-click": "activate",
    "separate-outputs": true,
    "sort-by-number": true,
    "persistent-workspaces": {
      "DP-2": [1, 2, 3, 4, 5],
      "DP-1": [6, 7, 8, 9]
    }
  },

  "group/system": {
    "orientation": "horizontal",
    "modules": ["cpu", "memory", "disk"]
  },
  "cpu": {
    "interval": 2,
    "format": "<span color='#cba6f7'>󰻠</span> {usage}%",
    "tooltip": false
  },
  "memory": {
    "interval": 3,
    "format": "<span color='#cba6f7'>󰍛</span> {used:0.1f}G",
    "tooltip-format": "{used:0.1f}G / {total:0.1f}G"
  },
  "disk": {
    "interval": 60,
    "path": "/home",
    "unit": "GB",
    "format": "<span color='#cba6f7'>󰋊</span> {free}",
    "tooltip-format": "{used} used of {total} on {path}"
  },

  "hyprland/language": {
    "format": "<span color='#cba6f7'>󰌌</span> {}",
    "format-en": "us"
  },

  "group/audio": {
    "orientation": "horizontal",
    "modules": ["pulseaudio", "pulseaudio#microphone"]
  },
  "pulseaudio": {
    "format": "<span color='#cba6f7'>{icon}</span> {volume}%",
    "format-muted": "<span color='#6c7086'>󰝟</span> muted",
    "format-icons": {
      "headphone": "󰋋",
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "tooltip": false,
    "on-click": "pavucontrol",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-scroll-up": "wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
  },
  "pulseaudio#microphone": {
    "format": "{format_source}",
    "format-source": "<span color='#cba6f7'>󰍬</span> {volume}%",
    "format-source-muted": "<span color='#f38ba8'>󰍭</span>",
    "tooltip": false,
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
    "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 5%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 5%-"
  },

  "tray": {
    "icon-size": 16,
    "spacing": 8
  }
}
